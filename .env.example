# ==============================================================================
# 🌍 CONFIGURATION GLOBALE — The Universal Stack
# ==============================================================================

# ==========================================
# 📱 FRONTEND (EXPO / REACT NATIVE)
# ==========================================
# URL de l'API consommée par le Frontend (Expo Router)
# Sur émulateur Android, localhost est automatiquement traduit en 10.0.2.2
EXPO_PUBLIC_API_URL=http://localhost:3000

# Port de l'environnement de développement Frontend (Expo par défaut : 8081)
PORT=8081

# ==========================================
# ⚙️ BACKEND (API)
# ==========================================
# Port exposé par le conteneur Backend Hono
API_PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081

# Clé secrète (générée automatiquement dans .env par start.sh si laissée vide)
AUTH_SECRET=

# ==========================================
# 🗄️ BASE DE DONNÉES (POSTGRESQL + POSTGIS)
# ==========================================
POSTGRES_PASSWORD=postgres_password
POSTGRES_USER=postgres
POSTGRES_DB=universal_db
DB_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}

# ==========================================
# 🔴 REDIS & HARVESTER (INGESTION ASYNCHRONE)
# ==========================================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
HARVESTER_PORT=3001
HARVESTER_DB_POOL=5
HARVESTER_ENABLE_EXAMPLE=0
HARVESTER_EXAMPLE_URL=
