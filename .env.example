# ==============================================================================
# 🌍 CONFIGURATION GLOBALE — The Universal Stack
# ==============================================================================

# ==========================================
# 📱 FRONTEND (EXPO / REACT NATIVE)
# ==========================================
# URL de l'API consommée par le Frontend (Expo Router)
# Remplacez "localhost" par l'IP de votre machine si vous testez sur un appareil physique
EXPO_PUBLIC_API_URL=http://localhost:3000

# Port de l'environnement de développement Frontend (Expo par défaut : 8081)
PORT=8081

# ==========================================
# ⚙️ BACKEND (API)
# ==========================================
# Port exposé par le conteneur Backend Hono
API_PORT=3000
# Environnement applicatif
NODE_ENV=development

# Clé secrète pour le hachage cryptographique et les sessions (Argon2 / JWT / etc.)
# ⚠️ À IMPÉRATIVEMENT MODIFIER EN PRODUCTION
AUTH_SECRET=super_secret_changeme_for_production

# ==========================================
# 🗄️ BASE DE DONNÉES (POSTGRESQL + POSTGIS)
# ==========================================
# Mot de passe pour la base de données
POSTGRES_PASSWORD=postgres_password
# Utilisateur de la base de données
POSTGRES_USER=postgres
# Nom de la base de données
POSTGRES_DB=universal_db
# Port exposé sur la machine hôte
DB_PORT=5432

# URL de connexion destinée à l'ORM (Drizzle) côté Backend
# Lors de l'exécution dans Docker, l'hôte (database) doit correspondre au nom du service Postgres
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}
